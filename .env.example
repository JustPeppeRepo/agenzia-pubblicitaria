# Public site URL (no trailing slash) — used by sitemap / metadata / Open Graph / CSRF origin checks
NEXT_PUBLIC_SITE_URL=https://marcoddev.it

# Optional: Google Search Console HTML tag verification code
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional but recommended in production (multi-instance rate limiting via Upstash Redis)
# Create a free Redis DB at https://console.upstash.com → REST API keys
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Contact form: /api/contact validates; browser delivers via FormSubmit to siteConfig.email.
# On first submission, confirm the activation email in that inbox.
