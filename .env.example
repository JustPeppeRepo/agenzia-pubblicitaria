# Public site URL (no trailing slash) — used by sitemap/metadata
NEXT_PUBLIC_SITE_URL=https://marcoddev.it

# Resend — server-only, never prefix with NEXT_PUBLIC_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form messages
CONTACT_TO_EMAIL=ciao@marcoddev.it

# Verified sender on Resend (domain must be verified)
CONTACT_FROM_EMAIL=noreply@marcoddev.it
